#!/usr/bin/env bash

VERSION="1.1.R"

set -e

DRY_RUN=false
INSTALL_SNAP=false
INSTALL_FLATPAK=false

UPDATED=()

RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
RESET="\033[0m"

log() { echo -e "${BLUE}[INFO]${RESET} $1"; }
ok() { echo -e "${GREEN}[OK]${RESET} $1"; }
warn() { echo -e "${YELLOW}[WARN]${RESET} $1"; }

run() {
    if [ "$DRY_RUN" = true ]; then
        echo -e "${YELLOW}[DRY-RUN]${RESET} $*"
    else
        eval "$@"
    fi
}

has_cmd() {
    command -v "$1" >/dev/null 2>&1
}

print_help() {
cat <<EOF
updateall v1.1.R

Usage:
  $0 [OPTIONS]

Options:
  --dry-run
  --install-snap
  --install-flatpak
  --help
  --version
  --news
EOF
}

print_version() {
    echo "updateall v$VERSION"
}

news() {
    echo "Update list: 
          FIXES: Fixed Emerge, homebrew and nix bugs that caused system break (tested in VM)
          new additions: added a Reboot Y/N (idk why)"
}

for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        --install-snap) INSTALL_SNAP=true ;;
        --install-flatpak) INSTALL_FLATPAK=true ;;
        --help) print_help; exit 0 ;;
        --version) print_version; exit 0 ;;
        --news) news; exit 0 ;;
        *) warn "Unknown option: $arg"; exit 1 ;;
    esac
done

echo "ULU v$VERSION"
echo ""

install_snap() {
    log "Installing Snap"
    if has_cmd apt; then
        run "sudo apt update && sudo apt install -y snapd"
    elif has_cmd dnf; then
        run "sudo dnf install -y snapd"
    elif has_cmd pacman; then
        warn "Snap not supported via pacman"
    fi
}

install_flatpak() {
    log "Installing Flatpak"
    if has_cmd apt; then
        run "sudo apt install -y flatpak"
    elif has_cmd dnf; then
        run "sudo dnf install -y flatpak"
    elif has_cmd pacman; then
        run "sudo pacman -S flatpak"
    fi
}

if [ "$INSTALL_SNAP" = true ] && ! has_cmd snap; then
    install_snap
fi

if [ "$INSTALL_FLATPAK" = true ] && ! has_cmd flatpak; then
    install_flatpak
fi

log "Running updates"

if has_cmd apt; then
    log "APT"
    run "sudo apt update"
    run "sudo apt full-upgrade -y"
    run "sudo apt autoremove -y"
    run "sudo apt autoclean"
    UPDATED+=("apt")
    ok "APT done"
fi

if has_cmd dnf; then
    log "DNF"
    run "sudo dnf upgrade --refresh -y"
    UPDATED+=("dnf")
    ok "DNF done"
fi

if has_cmd yum; then
    log "YUM"
    run "sudo yum update -y"
    UPDATED+=("yum")
    ok "YUM done"
fi

if has_cmd pacman; then
    log "Pacman"
    run "sudo pacman -Syu"
    UPDATED+=("pacman")
    ok "Pacman done"
fi

if has_cmd zypper; then
    log "Zypper"
    run "sudo zypper refresh"
    run "sudo zypper update -y"
    UPDATED+=("zypper")
    ok "Zypper done"
fi

if has_cmd emerge; then
    warn "Portage detected"
    run "sudo emerge --sync"
    run "sudo emerge -uDNav @world"
    UPDATED+=("portage")
    ok "Portage done"
fi

if has_cmd yay; then
    log "Yay"
    run "yay -Syu"
    UPDATED+=("yay")
    ok "Yay done"
fi

if has_cmd paru; then
    log "Paru"
    run "paru -Syu"
    UPDATED+=("paru")
    ok "Paru done"
fi

if has_cmd flatpak; then
    log "Flatpak"
    run "flatpak update -y"
    UPDATED+=("flatpak")
    ok "Flatpak done"
fi

if has_cmd snap; then
    log "Snap"
    run "sudo snap refresh"
    UPDATED+=("snap")
    ok "Snap done"
fi

if has_cmd nix-env; then
    log "Nix"
    run "nix-channel --update"
    run "nix-env -u '*'"
    UPDATED+=("nix")
    ok "Nix done"
fi

if has_cmd brew; then
    log "Homebrew"
    run "brew update"
    run "brew upgrade"
    run "brew cleanup"
    UPDATED+=("brew")
    ok "Homebrew done"
fi

echo ""
echo "Update Summary"

if [ ${#UPDATED[@]} -eq 0 ]; then
    warn "No package managers detected"
else
    for u in "${UPDATED[@]}"; do
        echo "✔ $u"
    done
fi

echo ""

read -p "Reboot now? (10-second countdown) [Y/N]: " REBOOT_CHOICE

if [[ "$REBOOT_CHOICE" =~ ^[Yy]$ ]]; then
    log "Rebooting in 10 seconds... press CTRL+C to cancel"

    for i in {10..1}; do
        echo -ne "\rRebooting in $i seconds..."
        sleep 1
    done

    echo ""

    if [ "$DRY_RUN" = true ]; then
        warn "[DRY-RUN] reboot skipped"
    else
        log "Rebooting"
        sudo reboot
    fi
else
    ok "Reboot skipped"
fi

echo ""
ok "Done"
